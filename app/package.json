{
  "name": "meridian-relationship-desk",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "npm run build:server && npm run build:client",
    "build:server": "esbuild server/server.ts --bundle --platform=node --format=esm --outfile=dist/server.js --packages=external",
    "build:client": "./node_modules/.bin/vite build --config client/vite.config.ts",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@databricks/appkit": "latest",
    "@databricks/appkit-ui": "latest",
    "express": "^5.0.0",
    "drizzle-orm": "^0.38.0",
    "@openai/agents": "^0.1.0",
    "openai": "^4.70.0",
    "mlflow-tracing": "*",
    "zod": "^3.23.0",
    "jsonc-parser": "^3.3.0",
    "pg": "^8.13.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^7.0.0",
    "react-router-dom": "^7.0.0",
    "lucide-react": "^0.460.0",
    "recharts": "^2.15.0",
    "tailwindcss-animate": "^1.0.7",
    "vite": "^6.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@tailwindcss/vite": "^4.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0"
  },
  "devDependencies": {
    "drizzle-kit": "^0.30.0"
  }
}
